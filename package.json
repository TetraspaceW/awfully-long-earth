{
  "name": "awfully-long-earth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An endless Big Earth of Earth-sized sheets around real Earth, generated tile by tile; a headless world engine plus an explorer UI.",
  "scripts": {
    "build-earth": "node scripts/build-earth.mjs",
    "build": "node scripts/build.mjs",
    "lint": "eslint .",
    "check:layers": "node scripts/check-layers.mjs",
    "test:unit": "node --test 'test/unit/*.test.mjs'",
    "test:determinism": "node test/determinism.mjs",
    "test:smoke": "node test/smoke.mjs",
    "test": "npm run lint && npm run check:layers && npm run test:unit && npm run test:determinism && npm run test:smoke",
    "serve": "npx --yes http-server -c-1 ."
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "globals": "^17.13.0"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./engine": "./src/engine.js",
    "./*": "./src/*"
  }
}
